# ShareSphere AI — Environment Variables Configuration Template
# Copy this file to .env and configure values according to your deployment environment.

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=sharesphere-super-secure-development-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Database Configuration (Node 24 native SQLite)
# Path relative to workspace root or absolute path
DATABASE_FILE=sharesphere.db

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Storage Adapter Configuration
# Supported adapters: local, s3 (mockable)
STORAGE_ADAPTER=local
STORAGE_UPLOAD_DIR=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
